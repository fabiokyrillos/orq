{
  "name": "orq WhatsApp bridge",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "orq/notify",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1",
      "name": "Webhook notify",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "credentials": { "httpHeaderAuth": { "id": "REPLACE", "name": "orq bearer" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "apikey", "value": "={{ $env.EVOLUTION_APIKEY }}" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $env.ORQ_OWNER_NUMBER, text: $json.body.text }) }}",
        "options": {}
      },
      "id": "a2",
      "name": "Evolution sendText",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { ok: true } }}", "options": {} },
      "id": "a3",
      "name": "Respond notify",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [520, 0]
    },

    {
      "parameters": {
        "httpMethod": "GET",
        "path": "orq/replies",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b1",
      "name": "Webhook replies",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 220],
      "credentials": { "httpHeaderAuth": { "id": "REPLACE", "name": "orq bearer" } }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, text, received_at FROM orq_messages WHERE direction = 'in' AND consumed_at IS NULL AND id > $1 ORDER BY id LIMIT 50",
        "options": { "queryReplacement": "={{ Number($json.query.since || 0) }}" }
      },
      "id": "b2",
      "name": "Select unconsumed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [260, 220],
      "credentials": { "postgres": { "id": "REPLACE", "name": "orq postgres" } },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { messages: $input.all().filter(i => i.json.id !== undefined).map(i => ({ id: i.json.id, text: i.json.text, received_at: i.json.received_at })) } }}",
        "options": {}
      },
      "id": "b3",
      "name": "Respond replies",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [520, 220]
    },

    {
      "parameters": {
        "httpMethod": "POST",
        "path": "orq/replies/ack",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c1",
      "name": "Webhook ack",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 440],
      "credentials": { "httpHeaderAuth": { "id": "REPLACE", "name": "orq bearer" } }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE orq_messages SET consumed_at = now() WHERE id = ANY($1::bigint[]) AND consumed_at IS NULL",
        "options": { "queryReplacement": "={{ '{' + ($json.body.ids || []).join(',') + '}' }}" }
      },
      "id": "c2",
      "name": "Mark consumed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [260, 440],
      "credentials": { "postgres": { "id": "REPLACE", "name": "orq postgres" } },
      "alwaysOutputData": true
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { ok: true } }}", "options": {} },
      "id": "c3",
      "name": "Respond ack",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [520, 440]
    },

    {
      "parameters": {
        "httpMethod": "POST",
        "path": "orq/evolution",
        "options": {}
      },
      "id": "d1",
      "name": "Webhook Evolution inbound",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 660]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "owner",
              "leftValue": "={{ ($json.body.data?.key?.remoteJid || '').split('@')[0] }}",
              "rightValue": "={{ $env.ORQ_OWNER_NUMBER }}",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "not-from-me",
              "leftValue": "={{ $json.body.data?.key?.fromMe === true }}",
              "rightValue": false,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d2",
      "name": "Only the owner",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [260, 660]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO orq_messages (direction, from_number, text) VALUES ('in', $1, $2)",
        "options": {
          "queryReplacement": "={{ [ ($json.body.data?.key?.remoteJid || '').split('@')[0], $json.body.data?.message?.conversation || $json.body.data?.message?.extendedTextMessage?.text || '' ] }}"
        }
      },
      "id": "d3",
      "name": "Insert inbound",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [520, 640],
      "credentials": { "postgres": { "id": "REPLACE", "name": "orq postgres" } }
    }
  ],
  "connections": {
    "Webhook notify": { "main": [ [ { "node": "Evolution sendText", "type": "main", "index": 0 } ] ] },
    "Evolution sendText": { "main": [ [ { "node": "Respond notify", "type": "main", "index": 0 } ] ] },
    "Webhook replies": { "main": [ [ { "node": "Select unconsumed", "type": "main", "index": 0 } ] ] },
    "Select unconsumed": { "main": [ [ { "node": "Respond replies", "type": "main", "index": 0 } ] ] },
    "Webhook ack": { "main": [ [ { "node": "Mark consumed", "type": "main", "index": 0 } ] ] },
    "Mark consumed": { "main": [ [ { "node": "Respond ack", "type": "main", "index": 0 } ] ] },
    "Webhook Evolution inbound": { "main": [ [ { "node": "Only the owner", "type": "main", "index": 0 } ] ] },
    "Only the owner": { "main": [ [ { "node": "Insert inbound", "type": "main", "index": 0 } ], [] ] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
