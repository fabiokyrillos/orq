{
  "name": "orq WhatsApp bridge",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "orq/notify",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1",
      "name": "Webhook notify",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "credentials": { "httpHeaderAuth": { "id": "REPLACE", "name": "orq bearer" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://EVOLUTION_HOST/message/sendText/INSTANCE_NAME",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: \"OWNER_NUMBER\", text: $json.body.text }) }}",
        "options": {}
      },
      "id": "a2",
      "name": "Evolution sendText",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "credentials": { "httpHeaderAuth": { "id": "REPLACE", "name": "evolution apikey" } }
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { ok: true } }}", "options": {} },
      "id": "a3",
      "name": "Respond notify",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [520, 0]
    },

    {
      "parameters": {
        "httpMethod": "GET",
        "path": "orq/replies",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b1",
      "name": "Webhook replies",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 220],
      "credentials": { "httpHeaderAuth": { "id": "REPLACE", "name": "orq bearer" } }
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": { "__rl": true, "mode": "name", "value": "orq_messages" },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            { "keyName": "consumed", "condition": "isFalse" },
            { "keyName": "id", "condition": "gt", "keyValue": "={{ Number($json.query.since || 0) }}" }
          ]
        },
        "returnAll": false,
        "limit": 50,
        "orderBy": true,
        "orderByColumn": "id",
        "orderByDirection": "ASC"
      },
      "id": "b2",
      "name": "Unconsumed rows",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [260, 220],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { messages: $input.all().filter(i => i.json.id !== undefined).map(i => ({ id: i.json.id, text: i.json.text, received_at: i.json.createdAt })) } }}",
        "options": {}
      },
      "id": "b3",
      "name": "Respond replies",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [520, 220]
    },

    {
      "parameters": {
        "httpMethod": "POST",
        "path": "orq/replies/ack",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c1",
      "name": "Webhook ack",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 440],
      "credentials": { "httpHeaderAuth": { "id": "REPLACE", "name": "orq bearer" } }
    },
    {
      "parameters": {
        "jsCode": "const ids = ($input.first().json.body || {}).ids || [];\nif (!ids.length) { return [{ json: { id: -1 } }]; }\nreturn ids.map(id => ({ json: { id: Number(id) } }));"
      },
      "id": "c2",
      "name": "One item per id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 440]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": { "__rl": true, "mode": "name", "value": "orq_messages" },
        "matchType": "allConditions",
        "filters": { "conditions": [ { "keyName": "id", "condition": "eq", "keyValue": "={{ $json.id }}" } ] },
        "columns": {
          "mappingMode": "defineBelow",
          "value": { "consumed": true },
          "schema": [
            { "id": "text", "displayName": "text", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "from_number", "displayName": "from_number", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "consumed", "displayName": "consumed", "required": false, "defaultMatch": false, "display": true, "type": "boolean", "canBeUsedToMatch": true }
          ]
        }
      },
      "id": "c3",
      "name": "Mark consumed",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [520, 440],
      "alwaysOutputData": true
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { ok: true } }}", "options": {} },
      "id": "c4",
      "name": "Respond ack",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [780, 440]
    },

    {
      "parameters": {
        "httpMethod": "POST",
        "path": "orq/evolution",
        "options": {}
      },
      "id": "d1",
      "name": "Webhook Evolution inbound",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 660]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "owner",
              "leftValue": "={{ ($json.body.data?.key?.remoteJid || '').split('@')[0] }}",
              "rightValue": "OWNER_NUMBER",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "not-from-me",
              "leftValue": "={{ $json.body.data?.key?.fromMe === true }}",
              "rightValue": false,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d2",
      "name": "Only the owner",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [260, 660]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": { "__rl": true, "mode": "name", "value": "orq_messages" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "text": "={{ $json.body.data?.message?.conversation || $json.body.data?.message?.extendedTextMessage?.text || '' }}",
            "from_number": "={{ ($json.body.data?.key?.remoteJid || '').split('@')[0] }}",
            "consumed": false
          },
          "schema": [
            { "id": "text", "displayName": "text", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "from_number", "displayName": "from_number", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "consumed", "displayName": "consumed", "required": false, "defaultMatch": false, "display": true, "type": "boolean", "canBeUsedToMatch": true }
          ]
        }
      },
      "id": "d3",
      "name": "Insert inbound",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [520, 640]
    }
  ],
  "connections": {
    "Webhook notify": { "main": [ [ { "node": "Evolution sendText", "type": "main", "index": 0 } ] ] },
    "Evolution sendText": { "main": [ [ { "node": "Respond notify", "type": "main", "index": 0 } ] ] },
    "Webhook replies": { "main": [ [ { "node": "Unconsumed rows", "type": "main", "index": 0 } ] ] },
    "Unconsumed rows": { "main": [ [ { "node": "Respond replies", "type": "main", "index": 0 } ] ] },
    "Webhook ack": { "main": [ [ { "node": "One item per id", "type": "main", "index": 0 } ] ] },
    "One item per id": { "main": [ [ { "node": "Mark consumed", "type": "main", "index": 0 } ] ] },
    "Mark consumed": { "main": [ [ { "node": "Respond ack", "type": "main", "index": 0 } ] ] },
    "Webhook Evolution inbound": { "main": [ [ { "node": "Only the owner", "type": "main", "index": 0 } ] ] },
    "Only the owner": { "main": [ [ { "node": "Insert inbound", "type": "main", "index": 0 } ], [] ] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
